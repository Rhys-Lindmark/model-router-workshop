# Optional. `npm run score` and `npm run route -- --offline <id>` need no keys.

# Jev (TypeSafe): route your own prompts live, and `npm run ask`.
# Get a key: https://docs.typesafe.ai/
TYPESAFE_API_KEY=

# OpenRouter: `npm run route -- --run "…"` sends the prompt to the picked model.
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
