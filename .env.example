# Optional at first: `npm run app`, `npm run score` and `npm run route -- --offline <id>` need no keys.
# See docs/KEYS.md. Paste each key after the =, with no quotes or spaces.

# Jev (TypeSafe): routes your own prompts, `npm run ask`, `npm run my-eval`, `npm run chat`.
# Get a key: https://console.typesafe.ai/keys
TYPESAFE_API_KEY=

# OpenRouter: the models your router picks between. `npm run chat`, `npm run my-eval`, the app's Answer button.
# Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
